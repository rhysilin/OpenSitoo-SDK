{
  "name": "opensitoo-developer-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1 --port 18700 --strictPort",
    "check": "node scripts/check-docs.mjs",
    "build": "npm run check && vitepress build docs",
    "preview": "vitepress preview docs --host 127.0.0.1 --port 18700 --strictPort",
    "docs:dev": "npm run dev",
    "docs:build": "node scripts/cloudflare-build.mjs",
    "docs:preview": "npm run preview"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vue": "3.5.43",
    "typescript": "5.6.2"
  }
}
